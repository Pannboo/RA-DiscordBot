# Discord
DISCORD_TOKEN=
# Optional: comma-separated guild IDs to instantly sync slash commands during dev.
# Leave blank in production to use global commands.
DEV_GUILD_IDS=

# RetroAchievements API
# Your RA username (the one the API key belongs to) and your Web API key.
RA_API_USERNAME=
RA_API_KEY=

# Postgres (optional: the Docker setup finds the database on its own;
# see "How the bot finds the database" in the README)
DATABASE_URL=postgresql+asyncpg://ra:ra@localhost:5432/ra_bot

# Polling tuning (seconds)
POLL_TICK_SECONDS=10
POLL_ACTIVE_SECONDS=30
POLL_IDLE_SECONDS=900
ACTIVE_WINDOW_SECONDS=3600

# How far back to look for recent achievements on each poll, in minutes.
# Should comfortably exceed POLL_IDLE_SECONDS so nothing slips through after long gaps.
RECENT_LOOKBACK_MINUTES=60

# Awards / milestones polling cadence (seconds). Cheaper than per-user achievement polls.
AWARDS_INTERVAL_SECONDS=900

# Logging
LOG_LEVEL=INFO
